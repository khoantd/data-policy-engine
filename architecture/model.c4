specification {
  element actor {
    style { shape person; color amber }
  }
  element system
  element container {
    technology 'N/A'
  }
  element component
  element containerDb {
    style { shape storage; icon tech:postgresql }
  }
  tag external
  tag critical

deploymentNode environment
deploymentNode region
deploymentNode kubernetes
deploymentNode namespace
deploymentNode managed
}

model {
  // Actors
  admin = actor 'Admin' 'Policy Admin'
  dpo = actor 'DPO' 'Data Protection Officer'

  // External Systems
  apps = system 'Apps' 'Integrating applications' {
    #external
  }
  llm = system 'LiteLLM' 'Optional AI assist' {
    #external
  }
  ogr = system 'OpenGuardrails' 'Optional runtime' {
    #external
  }
  hooks = system 'Webhooks' 'Downstream webhook targets' {
    #external
  }

  // Core System
  drpe = system 'ROS Policy' 'Retention & classification policy engine + Admin' {
    #critical

    // Containers
    adminConsole = container 'Admin Console' 'Next.js App Router' {
      metadata { owner 'platform-team' }
    }
    api = container 'REST API' 'FastAPI' {
      metadata { owner 'platform-team' }
    }
    sdk = container 'Python SDK' 'drpe package' {
      metadata { owner 'platform-team' }
    }
    core = container 'Engine Core' 'Python' {
      metadata { owner 'platform-team' }
    }
    scheduler = container 'Scheduler' 'Celery' {
      metadata { owner 'platform-team' }
    }
    db = containerDb 'PostgreSQL' 'Supabase / local' {
      metadata { owner 'platform-team' }
    }
    cache = container 'Redis' 'Cache + broker' {
      metadata { owner 'platform-team' }
    }
    ogrRuntime = container 'OpenGuardrails Runtime' 'Python package' {
      metadata { owner 'platform-team' }
    }

    // Components within Engine Core
    coreDSLParser = component 'DSL Parser' 'drpe/dsl/parser.py'
    coreEvaluator = component 'Evaluator' 'drpe/core/evaluator.py'
    coreClassifier = component 'Classifier' 'drpe/core/classifier.py'
    coreConflictResolver = component 'Conflict Resolver' 'drpe/core/conflict.py'
    coreJurisdictions = component 'Jurisdictions' 'drpe/core/jurisdictions.py'
    corePolicyDiff = component 'Policy Diff' 'drpe/core/policy_diff.py'
    coreEnforcement = component 'Enforcement' 'drpe/core/enforcement.py'
    coreDSAR = component 'DSAR Service' 'drpe/core/dsar.py'
    coreGuardrails = component 'Guardrails' 'drpe/guardrails/'
    corePrivacy = component 'Privacy' 'drpe/privacy/'
  }

  // Relationships
  // System Context
  admin -> drpe 'Admin UI + API key'
  dpo -> drpe 'Audit / DSAR / grace holds'
  apps -> drpe 'SDK or REST /api/v1'
  drpe -> llm 'Admin BFF only (masked prompts)'
  drpe -> ogr 'Guardrails evaluation when installed'
  drpe -> hooks 'Action dispatch'

  // Container Context
  adminConsole -> api 'DRPE_API_URL + Bearer key'
  sdk -> api 'HTTP'
  sdk -> core 'Embedded mode'
  api -> core 'In-process'
  api -> db 'SQLAlchemy'
  api -> cache 'Optional CachingPolicyStore'
  core -> ogrRuntime 'Optional runtime adapter'
  scheduler -> core 'EnforcementRunner'
  scheduler -> db 'Jobs + audit'
  scheduler -> cache 'Broker / backend'

  // Core Components
  core -> db 'Data persistence'
  core -> cache 'Cache usage'
  coreEnforcement -> db 'Audit logs'
  coreEnforcement -> cache 'Broker'
  coreGuardrails -> ogrRuntime 'Runtime adapter'
}

deployment {
environment prod {
    region eu-west-1 {
      kubernetes cluster {
        namespace apiNs {
          apiPod = instanceOf drpe.api {
            metadata { replicas '3'; zone 'public' }
          }
        }
        namespace coreNs {
          corePod = instanceOf drpe.core {
            metadata { zone 'public' }
          }
        }
        namespace workerNs {
          schedulerPod = instanceOf drpe.scheduler {
            metadata { zone 'public' }
          }
        }
        namespace dbNs {
          dbInstance = instanceOf drpe.db {
            metadata { zone 'public' }
          }
        }
        namespace cacheNs {
          cacheInstance = instanceOf drpe.cache {
            metadata { zone 'public' }
          }
        }
      }
      managed rds {
        instanceOf drpe.db {
          metadata { zone 'public' }
        }
      }
      managed elasticache {
        instanceOf drpe.cache {
          metadata { zone 'public' }
        }
      }
    }
    region us-east-1 {
      kubernetes cluster {
        namespace apiNs {
          apiPod = instanceOf drpe.api
        }
        namespace coreNs {
          corePod = instanceOf drpe.core
        }
        namespace workerNs {
          schedulerPod = instanceOf drpe.scheduler
        }
        namespace dbNs {
          dbInstance = instanceOf drpe.db
        }
        namespace cacheNs {
          cacheInstance = instanceOf drpe.cache
        }
      }
      managed rds {
        instanceOf drpe.db
      }
      managed elasticache {
        instanceOf drpe.cache
      }
    }
  }
}

views {
  view index {
    title 'ROS Policy — Landscape'
    include *
    autoLayout LeftRight
  }

  view drpeContext of drpe {
    title 'ROS Policy — System Context'
    include *
    include -> apps
    include -> llm
    include -> ogr
    include -> hooks
  }

  view drpeContainers of drpe {
    title 'ROS Policy — Containers'
    include *
    include adminConsole
    include api
    include sdk
    include core
    include scheduler
    include db
    include cache
    include ogrRuntime
  }

  view coreComponents of drpe.core {
    title 'ROS Policy — Engine Core Components'
    include *
    include coreDSLParser
    include coreEvaluator
    include coreClassifier
    include coreConflictResolver
    include coreJurisdictions
    include corePolicyDiff
    include coreEnforcement
    include coreDSAR
    include coreGuardrails
    include corePrivacy
  }

deployment view prod {
    title 'ROS Policy — Production Deployment'
    include *
    autoLayout TopBottom
    includeAncestors true
  }
}
