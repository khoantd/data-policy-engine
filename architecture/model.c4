specification {
  element actor { style { shape person; color amber } }
  element system
  element container { notation 'Service / Application' }
  element containerDb { notation 'Database' }
  element queue { notation 'Message Queue' }
  tag external

deploymentNode environment
deploymentNode region
deploymentNode kubernetes

deploymentNode namespace
}

model {
  admin = actor 'Policy Admin' 'Authors policies, runs evaluate/classify/guardrails playgrounds'
  dpo = actor 'DPO / Compliance' 'Reviews audit, DSAR, grace holds'

  drpe = system 'ROS Policy' 'Retention, classification, and agent guardrails engine + Admin'

  adminConsole = container 'Admin Console' 'Next.js App Router' {
    technology 'Next.js'
    metadata { owner 'platform-team' }
  }

  api = container 'REST API' 'FastAPI' {
    technology 'FastAPI'
    metadata { owner 'platform-team' }
  }

  sdk = container 'Python SDK' 'drpe package' {
    technology 'Python'
    metadata { owner 'platform-team' }
  }

  coreEngine = container 'Engine Core' 'Python' {
    technology 'Python'
    metadata { owner 'platform-team' }
  }

  scheduler = container 'Scheduler' 'Celery' {
    technology 'Celery'
    metadata { owner 'platform-team' }
  }

  db = containerDb 'PostgreSQL' 'Supabase / local' {
    technology 'PostgreSQL'
    metadata { owner 'platform-team' }
  }

  cache = container 'Redis' 'Cache + broker' {
    technology 'Redis'
    metadata { owner 'platform-team' }
  }

  guardrailsRuntime = container 'OpenGuardrails Runtime' 'Python package' {
    technology 'Python'
    metadata { owner 'platform-team' }
  }

  externalApps = system 'Integrating apps' 'CRM / ERP / data platform' { #external
    metadata { owner 'platform-team' }
  }

  externalLLM = system 'LiteLLM' 'Optional AI assist for Admin import/samples' { #external
    metadata { owner 'platform-team' }
  }

  externalOGR = system 'OpenGuardrails' 'Optional runtime for GuardEvent evaluation' { #external
    metadata { owner 'platform-team' }
  }

  externalHooks = system 'Downstream webhooks' 'Receive enforcement actions' { #external
    metadata { owner 'platform-team' }
  }

  admin -> drpe 'Admin UI + API key'
  dpo -> drpe 'Audit / DSAR / grace holds'
  externalApps -> drpe 'SDK or REST /api/v1'
  drpe -> externalLLM 'Admin BFF only (masked prompts)'
  drpe -> externalOGR 'Guardrails evaluation when installed'
  drpe -> externalHooks 'Action dispatch'

  admin -> api 'DRPE_API_URL + Bearer key'
  admin -> externalLLM 'AI suggest / samples'
  sdk -> api 'HTTP'
  sdk -> coreEngine 'Embedded mode'
  api -> coreEngine 'In-process'
  api -> db 'SQLAlchemy'
  api -> cache 'Optional CachingPolicyStore'
  coreEngine -> guardrailsRuntime 'Optional runtime adapter'
  scheduler -> coreEngine 'EnforcementRunner'
  scheduler -> db 'Jobs + audit'
  scheduler -> cache 'Broker / backend'
}

deployment {
environment prod {
    region euWest1 'eu-west-1' {
      kubernetes cluster {
        instanceOf adminConsole
        instanceOf api
        instanceOf sdk
        instanceOf coreEngine
        instanceOf scheduler
        instanceOf cache
        instanceOf guardrailsRuntime
        instanceOf db
      }
    }
  }

environment staging {
    region euWest1 {
      kubernetes cluster {
        instanceOf adminConsole
        instanceOf api
        instanceOf sdk
        instanceOf coreEngine
        instanceOf scheduler
        instanceOf cache
        instanceOf guardrailsRuntime
        instanceOf db
      }
    }
  }
}

views {
  view index {
    title 'ROS Policy Landscape'
    include *
    autoLayout LeftRight
  }

  view systemContext of drpe {
    title 'ROS Policy — System Context'
    include *
    include -> *
    autoLayout LeftRight
  }

  view containers of drpe {
    title 'ROS Policy — Containers'
    include *
    include -> *
    autoLayout LeftRight
  }

  dynamic view evaluateFlow {
    title 'Evaluation Flow'
    admin -> api 'Open API /evaluate'
    api -> coreEngine 'Process request'
    coreEngine -> db 'Read policy'
    coreEngine -> guardrailsRuntime 'Guardrails evaluation (if enabled)'
    guardrailsRuntime -> api 'Return verdict'
    api -> cache 'Cache policy'
  }

deployment view prod {
    title 'Production Deployment'
    include prod.**
    autoLayout TopBottom
  }

deployment view staging {
    title 'Staging Deployment'
    include staging.**
    autoLayout TopBottom
  }

deployment view prodAncestors {
    title 'Production Deployment — Full Hierarchy'
    include prod
    include prod.euWest1
    include prod.euWest1.cluster
    include prod.euWest1.cluster.**
    autoLayout TopBottom
  }

dynamic view enforcementJobFlow {
    title 'Enforcement Job Flow'
    scheduler -> coreEngine 'Run enforcement job'
    coreEngine -> db 'Read pending jobs'
    coreEngine -> db 'Write audit logs'
    coreEngine -> cache 'Publish job to broker'
    coreEngine -> cache 'Consume job queue'
  }
}
