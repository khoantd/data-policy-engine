specification {
  element actor
  element system
  element systemExt
  element container
  element containerExt
  element containerDb
  element component
}

model {
  admin = actor 'Policy Admin' {
    description 'Authors policies, runs evaluate/classify/guardrails playgrounds'
  }
  dpo = actor 'DPO / Compliance' {
    description 'Reviews audit, DSAR, grace holds'
  }

  drpe = system 'ROS Policy' {
    description 'Retention, classification, and agent guardrails engine + Admin'
    metadata { owner 'drpe-team' }

    adminConsole = container 'Admin Console' {
      description 'Next.js App Router, BFF, playgrounds, policy import AI'
      technology 'Next.js 14'
      metadata { owner 'drpe-team' }
    }
    api = container 'REST API' {
      description 'FastAPI /api/v1 policy, evaluate, classify, guardrails, enforce, DSAR…'
      technology 'FastAPI'
      metadata { owner 'drpe-team' }
    }
    sdk = container 'Python SDK' {
      description 'drpe package, remote client + embedded evaluator'
      technology 'Python'
      metadata { owner 'drpe-team' }
    }
    core = container 'Engine Core' {
      description 'Python: DSL, evaluate, classify, guardrails, enforce, DSAR'
      technology 'Python'
      metadata { owner 'drpe-team' }

      dslParser = component 'DSL Parser' {
        description 'YAML → Pydantic Policy / classification policy'
      }
      evaluator = component 'Evaluator' {
        description 'Match scope + rules; lowest priority wins'
      }
      classifier = component 'Classifier' {
        description 'Entity detection vs classification policies'
      }
      conflictResolver = component 'Conflict Resolver' {
        description 'Surface overlapping matches'
      }
      jurisdictions = component 'Jurisdictions' {
        description 'Built‑in jurisdiction metadata'
      }
      policyDiff = component 'Policy Diff' {
        description 'Structural version diff'
      }
      enforcement = component 'Enforcement' {
        description 'Scan records, grace, dispatch, audit'
      }
      dsarService = component 'DSAR Service' {
        description 'Sync access/erasure workflows'
      }
      guardrails = component 'Guardrails' {
        description 'Optional OpenGuardrails runtime wrapper + detectors'
      }
      privacy = component 'Privacy' {
        description 'Optional PII mask for AI / privacy APIs'
      }
    }
    scheduler = container 'Scheduler' {
      description 'Celery periodic + queued enforcement'
      technology 'Celery'
      metadata { owner 'drpe-team' }
    }
    db = containerDb 'PostgreSQL' {
      description 'Supabase / local, drpe schema'
      technology 'PostgreSQL'
      metadata { owner 'drpe-team' }
    }
    cache = container 'Redis' {
      description 'Cache + broker, policy cache, Celery'
      technology 'Redis'
      metadata { owner 'drpe-team' }
    }
    ogrRuntime = containerExt 'OpenGuardrails Runtime' {
      description 'Python package, optional GuardEvent runtime'
      technology 'Python'
      metadata { owner 'drpe-team' }
    }

    drpeExtApps = systemExt 'Integrating Apps' {
      description 'CRM / ERP / data platform'
      technology 'External'
    }
    drpeExtLLM = systemExt 'LiteLLM' {
      description 'Optional AI assist for Admin import/samples'
      technology 'External'
    }
    drpeExtOGR = systemExt 'OpenGuardrails' {
      description 'Optional runtime for GuardEvent evaluation'
      technology 'External'
    }
    drpeExtHooks = systemExt 'Downstream Webhooks' {
      description 'Receive enforcement actions'
      technology 'External'
    }
  }

  /* Relationships – System context level */
  admin -> drpe.adminConsole 'Admin UI + API key'
  dpo -> drpe 'Audit / DSAR / grace holds'
  drpe.drpeExtApps -> drpe 'SDK or REST /api/v1'
  drpe -> drpeExtLLM 'Admin BFF only (masked prompts)'
  drpe -> drpeExtOGR 'Guardrails evaluation when installed'
  drpe -> drpeExtHooks 'Action dispatch'

  /* Container interactions */
  drpe.adminConsole -> drpe.api 'DRPE_API_URL + Bearer key'
  drpe.adminConsole -> drpeExtLLM 'AI suggest / samples'
  drpe.sdk -> drpe.api 'HTTP'
  drpe.sdk -> drpe.core 'Embedded mode'
  drpe.api -> drpe.core 'In-process'
  drpe.api -> drpe.db 'SQLAlchemy'
  drpe.api -> drpe.cache 'Optional CachingPolicyStore'
  drpe.core -> drpe.ogrRuntime 'Optional runtime adapter'
  drpe.scheduler -> drpe.core 'EnforcementRunner'
  drpe.scheduler -> drpe.db 'Jobs + audit'
  drpe.scheduler -> drpe.cache 'Broker / backend'
}

views {
  view index {
    title 'ROS Policy – Landscape'
    description 'Top‑level view of the ROS Policy system and its ecosystem'
    include *
    autoLayout LeftRight
  }

  view drpeContext of drpe {
    title 'ROS Policy — System Context'
    include *
    include drpe -> drpeExtLLM
    include drpe -> drpeExtOGR
    include drpe -> drpeExtHooks
    include drpe -> drpeExtApps
  }

  view apiInternals of drpe.api {
    title 'REST API – Internal Dependencies'
    include *
    include drpe.api -> drpe.core
    include drpe.api -> drpe.db
    include drpe.api -> drpe.cache
  }

  view schedulerContext of drpe.scheduler {
    title 'Scheduler – Worker & Beat'
    include *
    include drpe.scheduler -> drpe.core
    include drpe.scheduler -> drpe.db
    include drpe.scheduler -> drpe.cache
  }
}
