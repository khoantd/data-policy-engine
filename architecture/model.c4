specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system
  element container {
    notation 'Service / Application'
    technology 'N/A'
  }
  element component
  element db {
    style {
      shape storage
      icon tech:postgresql
    }
  }
  relationship sync {
    technology 'HTTPS'
    color green
    line solid
    head normal
  }
}

model {
  admin = actor 'Policy Admin' 'Authors policies, runs evaluate/classify playgrounds'
  dpo = actor 'DPO / Compliance' 'Reviews audit, DSAR, grace holds'

  drpe = system 'ROS Policy' 'Retention & classification policy engine + Admin'

  apps = system 'Integrating apps' 'CRM / ERP / data platform'
  llm = system 'LiteLLM' 'Optional AI assist for Admin import/samples'
  hooks = system 'Downstream webhooks' 'Receive enforcement actions'

  adminConsole = container 'Admin Console' 'Next.js App Router' 'BFF, playgrounds, policy import AI' {
    metadata {
      owner 'policy-engine'
    }
  }
  api = container 'REST API' 'FastAPI' '/api/v1 policy, evaluate, classify, enforce, DSAR…' {
    metadata {
      owner 'policy-engine'
    }
  }
  sdk = container 'Python SDK' 'drpe package' 'Remote client + embedded evaluator' {
    metadata {
      owner 'policy-engine'
    }
  }
  core = container 'Engine Core' 'Python' 'DSL, evaluate, classify, enforce, DSAR' {
    metadata {
      owner 'policy-engine'
    }
    dslParser = component 'DSL Parser' 'drpe/dsl/parser.py' 'YAML → Pydantic Policy'
    evaluator = component 'Evaluator' 'drpe/core/evaluator.py' 'Match scope + rules'
    classifier = component 'Classifier' 'drpe/core/classifier.py' 'Entity detection vs policies'
    conflictResolver = component 'Conflict Resolver' 'drpe/core/conflict.py' 'Surface overlapping matches'
    jurisdictions = component 'Jurisdictions' 'drpe/core/jurisdictions.py' 'Built‑in metadata'
    policyDiff = component 'Policy Diff' 'drpe/core/policy_diff.py' 'Structural version diff'
    enforcement = component 'Enforcement' 'drpe/core/enforcement.py' 'Scan records, dispatch, audit'
    dsarService = component 'DSAR Service' 'drpe/core/dsar.py' 'Sync access/erasure workflows'
    privacy = component 'Privacy' 'drpe/privacy/' 'Optional PII mask for AI / privacy APIs'
  }
  sched = container 'Scheduler' 'Celery' 'Periodic + queued enforcement' {
    metadata {
      owner 'policy-engine'
    }
  }
  db = db 'PostgreSQL' 'Supabase / local' 'drpe schema' {
    metadata {
      owner 'policy-engine'
    }
  }
  cache = container 'Redis' 'Cache + broker' 'Policy cache, gen stamp, Celery' {
    metadata {
      owner 'policy-engine'
    }
  }

  // Actors to system
  admin -> drpe 'Admin UI + API key'
  dpo -> drpe 'Audit / DSAR / grace holds'
  apps -> drpe 'SDK or REST /api/v1'
  drpe -> llm 'Admin BFF only (masked prompts)'
  drpe -> hooks 'Action dispatch'

  // SDK and API interactions
  sdk -> api 'HTTP'
  sdk -> core 'Embedded mode'
  api -> core 'In-process'
  api -> db 'SQLAlchemy'
  api -> cache 'Optional CachingPolicyStore'

  // Scheduler to core and stores
  sched -> core 'EnforcementRunner'
  sched -> db 'Jobs + audit'
  sched -> cache 'Broker / backend'
  sched -> hooks 'Webhook targets'

  // Admin console to API
  adminConsole -> api 'DRPE_API_URL + Bearer key'
  adminConsole -> llm 'AI suggest / samples'
}

views {
  view index {
    title 'ROS Policy — Landscape'
    include *
    autoLayout LeftRight
  }

  view containers of drpe {
    title 'ROS Policy — Containers'
    include *
  }

  view components of core {
    title 'Engine Core Components'
    include *
  }

  view external {
    title 'External Interactions'
    include *
    exclude drpe
    include -> *
  }
}
