specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system
  element container {
    notation 'Service / Application'
    technology 'N/A'
  }
  element component
  element db {
    style {
      shape storage
      icon tech:postgresql
    }
  }
  tag external
}

model {
  // Actors
  actor admin 'Policy Admin' 'Authors policies, runs evaluate/classify/guardrails playgrounds'
  actor dpo 'DPO / Compliance' 'Reviews audit, DSAR, grace holds'

  // External systems
  system apps 'Integrating apps' 'CRM / ERP / data platform' {
    #external
  }
  system llm 'LiteLLM' 'Optional AI assist for Admin import/samples' {
    #external
  }
  system ogr 'OpenGuardrails' 'Optional runtime for GuardEvent evaluation' {
    #external
  }
  system hooks 'Downstream webhooks' 'Receive enforcement actions' {
    #external
  }

  // ROS Policy system — containers/components nested under the system
  system drpe 'ROS Policy' 'Retention, classification, and agent guardrails engine + Admin' {
    container adminConsole 'Admin Console' 'Next.js App Router' {
      technology 'Next.js 14'
      metadata {
        owner 'platform-team'
      }
    }
    container api 'REST API' 'FastAPI' {
      technology 'FastAPI'
      metadata {
        owner 'platform-team'
      }
    }
    container sdk 'Python SDK' 'drpe package' {
      technology 'Python 3.12'
      metadata {
        owner 'platform-team'
      }
    }
    container core 'Engine Core' 'Python' {
      technology 'Python 3.12'
      metadata {
        owner 'platform-team'
      }
      // Core components
      component dslParser 'DSL Parser' 'YAML → Policy objects' {}
      component evaluator 'Evaluator' 'Match scope + rules' {}
      component classifier 'Classifier' 'Entity detection vs classification policies' {}
      component conflictResolver 'Conflict Resolver' 'Surface overlapping matches' {}
      component jurisdictions 'Jurisdictions' 'Built-in jurisdiction metadata' {}
      component policyDiff 'Policy Diff' 'Structural version diff' {}
      component enforcement 'Enforcement' 'Scan records, grace, dispatch, audit' {}
      component dsarService 'DSAR Service' 'Sync access/erasure workflows' {}
      component guardrails 'Guardrails' 'Optional OpenGuardrails runtime wrapper' {}
      component privacy 'Privacy' 'Optional PII mask for AI / privacy APIs' {}
    }
    container scheduler 'Scheduler' 'Celery' {
      technology 'Celery'
      metadata {
        owner 'platform-team'
      }
    }
    db db 'PostgreSQL' 'Supabase / local' {
      technology 'PostgreSQL 16'
      metadata {
        owner 'platform-team'
      }
    }
    container cache 'Redis' 'Cache + broker' {
      technology 'Redis'
      metadata {
        owner 'platform-team'
      }
    }
    container ogrRuntime 'OpenGuardrails Runtime' 'Python package' {
      technology 'OpenGuardrails'
      metadata {
        owner 'platform-team'
      }
    }
  }

  // Relationships
  // System context
  admin -> drpe 'Admin UI + API key'
  dpo -> drpe 'Audit / DSAR / grace holds'
  apps -> drpe 'SDK or REST /api/v1'
  drpe -> llm 'Admin BFF only (masked prompts)'
  drpe -> ogr 'Guardrails evaluation when installed'
  drpe -> hooks 'Action dispatch'

  // Containers (FQN under drpe)
  drpe.adminConsole -> drpe.api 'DRPE_API_URL + Bearer key'
  drpe.sdk -> drpe.api 'HTTP'
  drpe.sdk -> drpe.core 'Embedded mode'
  drpe.api -> drpe.core 'In-process'
  drpe.api -> drpe.db 'SQLAlchemy'
  drpe.api -> drpe.cache 'Optional CachingPolicyStore'
  drpe.core -> drpe.ogrRuntime 'Optional runtime adapter'
  drpe.scheduler -> drpe.core 'EnforcementRunner'
  drpe.scheduler -> drpe.db 'Jobs + audit'
  drpe.scheduler -> drpe.cache 'Broker / backend'
}

views {
  view index {
    title 'ROS Policy — Landscape'
    include *
    autoLayout LeftRight
  }

  view drpeContext of drpe {
    title 'ROS Policy — System Context'
    include *
    include -> *
    autoLayout TopBottom
  }

  view api of drpe.api {
    title 'REST API – Internal Dependencies'
    include *
    include -> drpe.db
    include -> drpe.cache
    autoLayout LeftRight
  }

  view coreComponents of drpe.core {
    title 'Engine Core – Components'
    include *
    autoLayout LeftRight
  }

  view externalSystems {
    title 'External Systems'
    include apps, llm, ogr, hooks
    autoLayout LeftRight
  }
}
