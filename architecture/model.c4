specification {
  element actor
  element system
  element container
  element component
  element db
  tag external
}

model {
  admin = actor 'Policy Admin'
  dpo = actor 'DPO / Compliance'
  apps = system 'Integrating apps' #external
  llm = system 'LiteLLM' #external
  ogr = system 'OpenGuardrails' #external
  hooks = system 'Downstream webhooks' #external

  drpe = system 'ROS Policy'

  adminConsole = container 'Admin Console' 'Next.js App Router' {
    metadata { owner 'platform-team' }
  }
  api = container 'REST API' 'FastAPI' '/api/v1' {
    metadata { owner 'platform-team' }
  }
  sdk = container 'Python SDK' 'drpe package' {
    metadata { owner 'platform-team' }
  }
  core = container 'Engine Core' 'Python' {
    metadata { owner 'platform-team' }

    dslParser = component 'DSL Parser' 'YAML → Policy Pydantic' {
      metadata { owner 'platform-team' }
    }
    evaluator = component 'Evaluator' 'Rule matching' {
      metadata { owner 'platform-team' }
    }
    classifier = component 'Classifier' 'Entity detection' {
      metadata { owner 'platform-team' }
    }
    conflictResolver = component 'Conflict Resolver' 'Resolve overlapping rules' {
      metadata { owner 'platform-team' }
    }
    jurisdiction = component 'Jurisdiction' 'Metadata' {
      metadata { owner 'platform-team' }
    }
    policyDiff = component 'Policy Diff' 'Structural diff' {
      metadata { owner 'platform-team' }
    }
    enforcement = component 'Enforcement' 'Scan & dispatch' {
      metadata { owner 'platform-team' }
    }
    dsarService = component 'DSAR Service' 'Access/erasure' {
      metadata { owner 'platform-team' }
    }
    guardrailsComp = component 'Guardrails' 'OpenGuardrails runtime' {
      metadata { owner 'platform-team' }
    }
    privacyComp = component 'Privacy' 'PII mask' {
      metadata { owner 'platform-team' }
    }
  }
  scheduler = container 'Scheduler' 'Celery' {
    metadata { owner 'platform-team' }
  }
  db = container 'PostgreSQL' 'Supabase / local' {
    metadata { owner 'infra-team' }
  }
  cache = container 'Redis' 'Cache + broker' {
    metadata { owner 'infra-team' }
  }
  ogrRuntime = container 'OpenGuardrails Runtime' 'Python package' {
    metadata { owner 'platform-team' }
  }

  // Core relationships
  admin -> api 'DRPE_API_URL + Bearer key'
  dpo -> api 'Audit / DSAR / grace holds'
  apps -> api 'SDK or REST /api/v1'
  sdk -> api 'HTTP'
  sdk -> core 'Embedded mode'
  api -> core 'In-process'
  api -> db 'SQLAlchemy'
  api -> cache 'Optional CachingPolicyStore'
  api -> llm 'Admin BFF only (masked prompts)'
  api -> ogr 'Guardrails evaluation when installed'
  api -> hooks 'Action dispatch'
  core -> ogr 'Optional runtime adapter'
  scheduler -> core 'EnforcementRunner'
  scheduler -> db 'Jobs + audit'
  scheduler -> cache 'Broker / backend'

  // API internal component delegations
  api -> dslParser 'Parser for YAML policies'
  api -> evaluator 'Delegates to evaluator'
  api -> classifier 'Delegates to classifier'
  api -> enforcement 'Triggers enforcement'
  api -> dsarService 'Provides DSAR endpoints'
}

views {
  view index {
    title 'ROS Policy Architecture Landscape'
    include *
    autoLayout LeftRight
  }

  view drpeContext of drpe {
    title 'ROS Policy — System Context'
    include *
  }

  view containers of drpe {
    title 'ROS Policy — Containers'
    include *
  }

  view coreComponents of core {
    title 'Engine Core Components'
    include *
  }
}
