specification {
  element actor { style { shape person; color amber } }
  element system
  element container
  element container_ext
  element container_db
  element component

  tag external
  tag critical
}

model {
  admin = actor 'Policy Admin' 'Authors policies, runs evaluate/classify/guardrails playgrounds'
  dpo   = actor 'DPO / Compliance' 'Reviews audit, DSAR, grace holds'

  drpe = system 'ROS Policy' 'Retention, classification, and agent guardrails engine + Admin'

  apps = system 'Integrating Apps' 'CRM / ERP / data platform' { #external }
  llm  = system 'LiteLLM' 'Optional AI assist for Admin import/samples' { #external }
  ogr  = system 'OpenGuardrails' 'Optional runtime for GuardEvent evaluation' { #external }
  hooks = system 'Downstream Webhooks' 'Receive enforcement actions' { #external }

  adminConsole = container 'Admin Console' 'Next.js App Router' 'BFF, playgrounds, policy import AI' {
    metadata { owner 'ops-team' }
  }
  api = container 'REST API' 'FastAPI' '/api/v1 policy, evaluate, classify, guardrails, enforce, DSAR…' {
    metadata { owner 'api-team' }
  }
  sdk = container 'Python SDK' 'drpe package' 'Remote client + embedded evaluator' {
    metadata { owner 'client-team' }
  }
  core = container 'Engine Core' 'Python' 'DSL, evaluate, classify, guardrails, enforce, DSAR' {
    metadata { owner 'engine-team' }
  }
  sched = container 'Scheduler' 'Celery' 'Periodic + queued enforcement' {
    metadata { owner 'worker-team' }
  }
  db = container_db 'PostgreSQL' 'Supabase / local' 'drpe schema' {
    metadata { owner 'db-team' }
  }
  cache = container_ext 'Redis' 'Cache + broker' 'Policy cache, gen stamp, Celery' {
    metadata { owner 'cache-team' }
  }
  ogrRuntime = container 'OpenGuardrails Runtime' 'Python package' 'Optional GuardEvent runtime' {
    metadata { owner 'guardrails-team' }
  }

  dslParser = component 'DSL Parser' 'drpe/dsl/parser.py' 'YAML → Pydantic Policy'
  evaluator = component 'Evaluator' 'drpe/core/evaluator.py' 'Match scope + rules'
  classifier = component 'Classifier' 'drpe/core/classifier.py' 'Entity detection vs classification policies'
  conflictResolver = component 'Conflict Resolver' 'drpe/core/conflict.py' 'Surface overlapping matches'
  jurisdictions = component 'Jurisdictions' 'drpe/core/jurisdictions.py' 'Built-in jurisdiction metadata'
  policyDiff = component 'Policy Diff' 'drpe/core/policy_diff.py' 'Structural version diff'
  enforcement = component 'Enforcement' 'drpe/core/enforcement.py' 'Scan records, grace, dispatch, audit'
  dsarService = component 'DSAR Service' 'drpe/core/dsar.py' 'Sync access/erasure workflows'
  guardrails = component 'Guardrails' 'drpe/guardrails/' 'Optional OpenGuardrails runtime wrapper + detectors'
  privacy = component 'Privacy' 'drpe/privacy/' 'Optional PII mask for AI / privacy APIs'

  adminConsole -> api 'DRPE_API_URL + Bearer key'
  sdk -> api 'HTTP'
  sdk -> core 'Embedded mode'
  api -> core 'In-process'
  api -> db 'SQLAlchemy'
  api -> cache 'Optional CachingPolicyStore'
  core -> ogrRuntime 'Optional runtime adapter'
  sched -> core 'EnforcementRunner'
  sched -> db 'Jobs + audit'
  sched -> cache 'Broker / backend'

  apps -> drpe 'SDK or REST /api/v1'
  llm  -> drpe 'Admin BFF only (masked prompts)'
  ogr  -> drpe 'Guardrails evaluation when installed'
  hooks -> drpe 'Action dispatch'
}

views {
  view index {
    title 'ROS Policy Architecture'
    description 'High‑level view of ROS Policy system'
    include *
    autoLayout LeftRight
  }

  view drpeContainers of drpe {
    title 'ROS Policy Containers'
    include *
    autoLayout TopBottom
  }

  view coreComponents of core {
    title 'Engine Core Components'
    include *
    autoLayout TopBottom
  }

view drpeContainersOverview of drpe {
    title 'ROS Policy Containers & External'
    include *
    include -> *
    autoLayout TopBottom
  }

view rosPolicyComponentsView of drpe {
    title 'ROS Policy Components'
    include adminConsole
    include api
    include sdk
    include core
    include sched
    include db
    include cache
    include ogrRuntime
    include core.*
    autoLayout LeftRight
  }
}
