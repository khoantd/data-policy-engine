specification {
  element actor
  element system
  element container
  element component
}

model {
  admin = actor 'Policy Admin'
  dpo = actor 'DPO / Compliance'
  apps = actor 'Integrating Apps'

  liteLLM = system 'LiteLLM' {
    description 'Optional AI assist for Admin import/samples'
  }
  webhookTargets = system 'Webhook Targets' {
    description 'Receive enforcement actions'
  }

  drpePolicy = system 'ROS Policy' {
    description 'Retention & classification policy engine + Admin'

    adminConsole = container 'Admin Console' {
      technology 'Next.js App Router'
      description 'BFF, playgrounds, policy import AI'
      metadata {
        owner 'admin'
      }
    }

    restApi = container 'REST API' {
      technology 'FastAPI'
      description '/api/v1 policy, evaluate, classify, enforce, DSAR'
      metadata {
        owner 'api'
      }
    }

    pythonSdk = container 'Python SDK' {
      technology 'drpe package'
      description 'Remote client + embedded evaluator'
      metadata {
        owner 'sdk'
      }
    }

    engineCore = container 'Engine Core' {
      technology 'Python'
      description 'DSL, evaluate, classify, enforce, DSAR'
      metadata {
        owner 'core'
      }

      dslParser = component 'DSL Parser' {
        description 'YAML to Policy model'
        metadata {
          owner 'core'
        }
      }
      evaluator = component 'Evaluator' {
        description 'Match scope + rules'
        metadata {
          owner 'core'
        }
      }
      classifier = component 'Classifier' {
        description 'Entity detection vs classification policies'
        metadata {
          owner 'core'
        }
      }
      conflictResolver = component 'Conflict Resolver' {
        description 'Surface overlapping matches'
        metadata {
          owner 'core'
        }
      }
      jurisdictions = component 'Jurisdictions' {
        description 'Built-in jurisdiction metadata'
        metadata {
          owner 'core'
        }
      }
      policyDiff = component 'Policy Diff' {
        description 'Structural version diff'
        metadata {
          owner 'core'
        }
      }
      enforcement = component 'Enforcement' {
        description 'Scan records, grace, dispatch, audit'
        metadata {
          owner 'core'
        }
      }
      dsarService = component 'DSAR Service' {
        description 'Sync access/erasure workflows'
        metadata {
          owner 'core'
        }
      }
      privacy = component 'Privacy' {
        description 'Optional PII mask for AI / privacy APIs'
        metadata {
          owner 'core'
        }
      }
    }

    scheduler = container 'Scheduler' {
      technology 'Celery'
      description 'Periodic + queued enforcement'
      metadata {
        owner 'worker'
      }
    }

    database = container 'PostgreSQL' {
      technology 'Supabase / local'
      description 'drpe schema'
      metadata {
        owner 'data'
      }
    }

    cache = container 'Redis' {
      technology 'Cache + broker'
      description 'Policy cache, gen stamp, Celery'
      metadata {
        owner 'data'
      }
    }
  }

  admin -> adminConsole 'DRPE_API_URL + Bearer key'
  dpo -> restApi 'Audit / DSAR / grace holds'
  apps -> restApi 'SDK or REST /api/v1'
  adminConsole -> restApi 'DRPE_API_URL + Bearer key'
  pythonSdk -> restApi 'HTTP'
  pythonSdk -> engineCore 'Embedded mode'
  restApi -> engineCore 'In-process'
  restApi -> database 'SQLAlchemy'
  restApi -> cache 'Optional CachingPolicyStore'
  scheduler -> engineCore 'EnforcementRunner'
  scheduler -> database 'Jobs + audit'
  scheduler -> cache 'Broker / backend'
  engineCore -> database 'PolicyStore, AuditStore'
  engineCore -> cache 'CachingPolicyStore (Redis)'
  adminConsole -> liteLLM 'AI assist (masked prompts)'
  engineCore -> webhookTargets 'Action dispatch'
  restApi -> webhookTargets 'Registers webhooks'
}

views {
  view index {
    title 'ROS Policy — System Context'
    include *
  }

  view adminConsoleView {
    title 'Admin Console'
    include adminConsole, restApi, pythonSdk, liteLLM
  }

  view restApiView {
    title 'REST API'
    include restApi, engineCore, database, cache, pythonSdk, webhookTargets, dpo, apps
  }

  view engineCoreView {
    title 'Engine Core'
    include engineCore, dslParser, evaluator, classifier, conflictResolver, jurisdictions, policyDiff, enforcement, dsarService, privacy, database, cache
  }

  view schedulerView {
    title 'Scheduler'
    include scheduler, engineCore, database, cache
  }

  view dataPlaneView {
    title 'Data Plane'
    include database, cache
  }

  view externalView {
    title 'External Services'
    include liteLLM, webhookTargets, adminConsole, engineCore
  }
}
