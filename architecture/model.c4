specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system
  element container {
    notation 'Service / Application'
    technology 'N/A'
  }
  element component
  element db {
    style {
      shape storage
      icon tech:postgresql
    }
  }

  tag external
}

model {
  // Actors
  admin = actor 'Policy Admin' 'Authors policies, runs evaluate/classify/guardrails playgrounds'
  dpo = actor 'DPO / Compliance' 'Reviews audit, DSAR, grace holds'

  // Main system
  drpe = system 'ROS Policy' 'Retention, classification, and agent guardrails engine + Admin'

  // External systems
  apps = system 'Integrating apps' 'CRM / ERP / data platform' {
    #external
  }
  llm = system 'LiteLLM' 'Optional AI assist for Admin import/samples' {
    #external
  }
  ogr = system 'OpenGuardrails' 'Optional runtime for GuardEvent evaluation' {
    #external
  }
  hooks = system 'Downstream webhooks' 'Receive enforcement actions' {
    #external
  }

  // Containers inside ROS Policy
  adminConsole = container 'Admin Console' 'Next.js App Router' {
    technology 'Next.js'
    metadata { owner 'policy-engine' }
  }
  api = container 'REST API' 'FastAPI' {
    technology 'FastAPI'
    metadata { owner 'policy-engine' }
  }
  sdk = container 'Python SDK' 'drpe package' {
    technology 'Python'
    metadata { owner 'policy-engine' }
  }
  core = container 'Engine Core' 'Python' {
    technology 'Python'
    metadata { owner 'policy-engine' }

    // Components of the core
    dslParser = component 'DSL Parser' 'YAML → Pydantic Policy objects'
    evaluator = component 'Evaluator' 'Matches scopes and rules'
    classifier = component 'Classifier' 'Entity detection vs policies'
    policyDiff = component 'Policy Diff' 'Structural version diff'
    enforcement = component 'Enforcement' 'Scan, grace holds, dispatch, audit'
    dsarService = component 'DSAR Service' 'Access/erasure workflows'
    guardrails = component 'Guardrails' 'OpenGuardrails runtime wrapper'
    conflictResolver = component 'Conflict Resolver' 'Surface overlapping matches'
    jurisdictions = component 'Jurisdictions' 'Built‑in jurisdiction metadata'
  }
  scheduler = container 'Scheduler' 'Celery' {
    technology 'Celery'
    metadata { owner 'policy-engine' }
  }
  cache = container 'Redis' 'Cache + broker' {
    technology 'Redis'
    metadata { owner 'policy-engine' }
  }
  ogrRuntime = container 'OpenGuardrails Runtime' 'Python package' {
    technology 'Python'
    metadata { owner 'policy-engine' }
  }
  db = container 'PostgreSQL' 'Supabase / local' {
    technology 'PostgreSQL'
    metadata { owner 'policy-engine' }
  }

  // Relationships
  admin -> api 'DRPE_API_URL + Bearer key'
  sdk -> api 'HTTP'
  sdk -> core 'Embedded mode'
  api -> core 'In-process'
  api -> db 'SQLAlchemy'
  api -> cache 'Optional CachingPolicyStore'
  core -> ogrRuntime 'Optional runtime adapter'
  scheduler -> core 'EnforcementRunner'
  scheduler -> db 'Jobs + audit'
  scheduler -> cache 'Broker / backend'
  drpe -> llm 'Admin BFF only (masked prompts)'
  drpe -> ogr 'Guardrails evaluation when installed'
  drpe -> hooks 'Action dispatch'
  dpo -> drpe 'Audit / DSAR / grace holds'
  apps -> drpe 'SDK or REST /api/v1'
}

views {
  view index {
    title 'ROS Policy Architecture'
    description 'High‑level view of the ROS Policy engine, its containers, and interactions'
    include *
    autoLayout LeftRight
  }

  view of drpe {
    title 'ROS Policy — Containers'
    include *
    include -> hooks
    include -> llm
    include -> ogr
    include -> apps
  }

  dynamic view enforcementFlow {
    title 'Enforcement Job Flow'
    sequence
    admin -> scheduler 'Trigger enforcement job via UI'
    scheduler -> core 'EnforcementRunner'
    core -> db 'Record audit log'
    core -> cache 'Update policy cache'
    core -> hooks 'Dispatch webhook'
    core -> ogr 'Evaluate GuardEvent (if runtime available)'
    core -> db 'Write enforcement result'
    core -> db 'Write grace hold if needed'
  }
}
